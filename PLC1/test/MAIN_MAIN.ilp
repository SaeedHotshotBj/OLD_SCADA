CTU   C32, %M2.6, 3600
__CR_EQ_1
MOVE    C32, %VW42
__CR_RESTORE
ST   %M2.6
(* Network 36 *)
(*____________________ Machine Time Query ____________________*)
LD    %SM0.0
AND(
LD    %M1.2
OR    %M1.7
OR    %M2.4
)
R_TRIG
S    %M3.0
(* Network 37 *)
(*____________________ Machine Query Flag ________________________________________ 122 ____________________*)
LD    %M3.0
MOVE    1, %VW44
TON   T60, 10
__CR_EQ_1
MOVE    T60, %VW600
__CR_RESTORE
R_TRIG
R    %M3.0
(* Network 38 *)
LDN    %M3.0
MOVE    0, %VW44
(* Network 39 *)
(*____________________ Voltage Phase to Phase ____________________*)
