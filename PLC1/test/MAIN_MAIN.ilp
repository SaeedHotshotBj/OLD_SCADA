LD    %SM0.0
MOVE    %VW1030, %VW30
(* Network 16 *)
(*____________________ Weight Query Flag ________________________________________ 118 ____________________*)
LD    %V200.0
MOVE    1, %VW36
(* Network 17 *)
LDN    %V200.0
MOVE    0, %VW36
(* Network 18 *)
(*____________________ Manual Power Off ________________________________________ 117 ____________________*)
LD    %SM0.0
EQ    %VW34, 0
ST   %M0.0
(* Network 19 *)
(*____________________ Auto Power Off & Reconnection ________________________________________ 116 ____________________*)
LD    %SM0.0
EQ    %VW32, 0
TON   T50, 150
__CR_EQ_1
MOVE    T50, %VW100
__CR_RESTORE
R_TRIG
R    %M0.1
(* Network 20 *)
LD    %SM0.0
EQ    %VW32, 1
TON   T51, 150
__CR_EQ_1
MOVE    T51, %VW102
__CR_RESTORE
R_TRIG
R    %M0.1
(* Network 21 *)
LD    %SM0.0
EQ    %VW32, 0
R_TRIG
S    %M0.1
(* Network 22 *)
(*____________________ Power Off Bit ____________________*)
LDN    %M0.1
ORN    %M0.0
R_TRIG
R    %Q0.0
(* Network 23 *)
LD    %M0.1
AND    %M0.0
R_TRIG
S    %Q0.0
(* Network 24 *)
(*____________________ Mill time ________________________________________ 119 ____________________*)
LD    %SM0.4
AND    %M1.0
CTU   C20, %M1.1, 10
__CR_EQ_1
MOVE    C20, %VW46
__CR_RESTORE
ST   %M1.1
(* Network 25 *)
LD    %SM0.0
AND    %M1.1
CTU   C22, %M1.2, 3
__CR_EQ_1
MOVE    C22, %VW48
__CR_RESTORE
ST   %M1.2
(* Network 26 *)
LD    %SM0.0
AND    %M1.2
CTU   C23, %M1.3, 3600
__CR_EQ_1
MOVE    C23, %VW50
__CR_RESTORE
ST   %M1.3
(* Network 27 *)
LD    %SM0.0
AND    %M1.3
CTU   C30, %M1.4, 3600
__CR_EQ_1
MOVE    C30, %VW38
__CR_RESTORE
ST   %M1.4
(* Network 28 *)
(*____________________ Mixer time ________________________________________ 120 ____________________*)
LD    %SM0.4
AND    %M1.5
CTU   C24, %M1.6, 60
__CR_EQ_1
MOVE    C24, %VW52
__CR_RESTORE
ST   %M1.6
(* Network 29 *)
LD    %SM0.0
AND    %M1.6
CTU   C25, %M1.7, 60
__CR_EQ_1
MOVE    C25, %VW54
__CR_RESTORE
ST   %M1.7
